		"test": "npm test --workspaces --if-present"
	},
	"prettier": "@dsiml/prettier-config",
	"devDependencies": {
		"eslint": "^9.39.5",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3"
	}
}
